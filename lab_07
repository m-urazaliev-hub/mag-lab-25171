# ============================================================
# Task 8 — Check a student ID
# ============================================================
# Write is_valid_id(value). Return True only if the entire string has two
# uppercase ASCII letters, one hyphen, and exactly four ASCII digits. Use
# re.fullmatch(). Test "AB-2047", "A-2047", and "xAB-2047".

# Write your code below:

print("Task 8 - Check a student ID")

import re

def is_valid_id(value):
    pattern = r"[A-Z]{2}-[0-9]{4}"
    return re.fullmatch(pattern, value) is not None

print(is_valid_id("AB-2047"))  # True
print(is_valid_id("A-2047"))   # False
print(is_valid_id("xAB-2047")) # False

# ============================================================
# Task 9 — Compare three regex functions
# ============================================================
# With pattern r"[0-9]+" and text "Room 204", print Boolean results from
# re.search(), re.match(), and re.fullmatch(). Then repeat fullmatch()
# with "204". Add a comment explaining each result.

# Write your code below:

print("Task 9 - Compare three regex functions")

pattern = r"[0-9]+"
text = "Room 204"

print(re.search(pattern, text) is not None)  # True, finds 204 anywhere
print(re.match(pattern, text) is not None)   # False, text does not start with digits
print(re.fullmatch(pattern, text) is not None)  # False, the whole text is not just digits

print(re.fullmatch(pattern, "204") is not None)  # True, the whole text is just digits

